# Cloud Agent Environment Variables (READ-ONLY CREDENTIALS)
# Copy this file to /opt/cloud-agent/.env.cloud and fill in values
#
# SECURITY: Cloud agent has READ-ONLY access only (FR-005)
# Write credentials (email send, social post, banking) stay on local machine

# Agent Configuration
AGENT_ID=cloud
CREDENTIAL_SCOPE=read_only

# LLM Provider (claude or gemini)
LLM_PROVIDER=claude

# Gmail (Read-Only)
# Create OAuth2 credentials with read-only scope: https://mail.google.com/
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token

# Facebook (Read-Only)
# Create app with read permissions: https://developers.facebook.com/
FACEBOOK_ACCESS_TOKEN=your-read-only-token

# Instagram (Read-Only)
# Use Facebook Graph API with Instagram permissions
INSTAGRAM_ACCESS_TOKEN=your-read-only-token

# Twitter (Read-Only)
# Create app with read-only permissions: https://developer.twitter.com/
TWITTER_API_KEY=your-api-key
TWITTER_API_SECRET=your-api-secret
TWITTER_ACCESS_TOKEN=your-access-token
TWITTER_ACCESS_SECRET=your-access-secret

# Odoo (Read-Only User)
# Create read-only user in Odoo with limited permissions
ODOO_URL=https://your-domain.com
ODOO_DB=odoo
ODOO_USERNAME=readonly_user
ODOO_PASSWORD=readonly_password

# Vault Sync
VAULT_PATH=/opt/cloud-agent/obsidian-vault
SYNC_METHOD=git
SYNC_INTERVAL=30

# Health Monitoring
HEALTH_CHECK_INTERVAL=300
ALERT_CHANNELS=email,sms,push

# Alert Configuration (Optional)
# Email alerts
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=your-email@example.com
ALERT_EMAIL_PASSWORD=your-app-password

# SMS alerts (Twilio)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+1234567890

# Push alerts (Pushover or ntfy.sh)
PUSHOVER_API_TOKEN=your-api-token
PUSHOVER_USER_KEY=your-user-key
