# Digital FTE Environment Variables
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git - it's in .gitignore

# Odoo Configuration
ODOO_URL=https://your-odoo-instance.com
ODOO_DATABASE=your_database_name
ODOO_USERNAME=admin
ODOO_PASSWORD=your_password_here

# Facebook Configuration
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# Twitter/X Configuration
TWITTER_CONSUMER_KEY=your_twitter_consumer_key
TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# Instagram Configuration
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Optional: Email Configuration (if using Gmail)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=watchers/.auth/gmail_token.json

# Optional: WhatsApp Configuration
WHATSAPP_PHONE_NUMBER=+1234567890

# Vault Configuration
VAULT_PATH=obsidian-vault

# Polling Intervals (seconds)
ODOO_POLL_INTERVAL=300
SOCIAL_POLL_INTERVAL=300
BRIEFING_SCHEDULE_TIME=08:00
BRIEFING_TIMEZONE=America/New_York

# Rate Limits
MAX_SOCIAL_POSTS_PER_DAY=10
MAX_EMAILS_PER_DAY=100

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=300
